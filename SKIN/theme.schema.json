{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l3xtownbeats.github.io/ppgu/skin-theme.schema.json",
  "title": "PPGU Skin Theme Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "index",
    "name",
    "description",
    "cluster",
    "identity",
    "tokens",
    "assets",
    "assetSpec",
    "compatibility",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^skin-[0-9]{2}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "cluster": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "material",
        "lighting",
        "mood"
      ],
      "properties": {
        "material": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "mood": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "canvas",
        "surfaces",
        "borders",
        "typography",
        "rotary",
        "sliders",
        "buttons",
        "tabs",
        "comboBoxes",
        "keyboard",
        "meters",
        "icons",
        "thumbnails",
        "windowChrome",
        "hero",
        "accents",
        "texture",
        "lighting"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "minProperties": 1
        },
        "surfaces": {
          "type": "object",
          "minProperties": 1
        },
        "borders": {
          "type": "object",
          "minProperties": 1
        },
        "typography": {
          "type": "object",
          "minProperties": 1
        },
        "rotary": {
          "type": "object",
          "minProperties": 1
        },
        "sliders": {
          "type": "object",
          "minProperties": 1
        },
        "buttons": {
          "type": "object",
          "minProperties": 1
        },
        "tabs": {
          "type": "object",
          "minProperties": 1
        },
        "comboBoxes": {
          "type": "object",
          "minProperties": 1
        },
        "keyboard": {
          "type": "object",
          "minProperties": 1
        },
        "meters": {
          "type": "object",
          "minProperties": 1
        },
        "icons": {
          "type": "object",
          "minProperties": 1
        },
        "thumbnails": {
          "type": "object",
          "minProperties": 1
        },
        "windowChrome": {
          "type": "object",
          "minProperties": 1
        },
        "hero": {
          "type": "object",
          "minProperties": 1
        },
        "accents": {
          "type": "object",
          "minProperties": 1
        },
        "texture": {
          "type": "object",
          "minProperties": 1
        },
        "lighting": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": [
        "preview",
        "hero"
      ],
      "properties": {
        "preview": {
          "type": "string",
          "minLength": 1
        },
        "hero": {
          "type": "string",
          "minLength": 1
        },
        "texture": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assetSpec": {
      "type": "object",
      "required": [
        "preview",
        "hero"
      ],
      "properties": {
        "preview": {
          "type": "object",
          "required": [
            "width",
            "height",
            "format"
          ]
        },
        "hero": {
          "type": "object",
          "required": [
            "width",
            "height",
            "format"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minimumPluginVersion",
        "apvtsChanges",
        "layoutChanges",
        "audioChanges"
      ],
      "properties": {
        "minimumPluginVersion": {
          "type": "string"
        },
        "apvtsChanges": {
          "const": false
        },
        "layoutChanges": {
          "const": false
        },
        "audioChanges": {
          "const": false
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "json",
        "assets",
        "runtime",
        "flStudio20"
      ],
      "properties": {
        "json": {
          "type": "string"
        },
        "assets": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "flStudio20": {
          "type": "string"
        }
      }
    }
  }
}
