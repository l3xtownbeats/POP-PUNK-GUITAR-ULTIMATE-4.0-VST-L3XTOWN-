{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l3xtownbeats.github.io/ppgu/skin-theme.schema.json",
  "title": "PPGU Skin Theme Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "index",
    "name",
    "description",
    "cluster",
    "identity",
    "tokens",
    "assets",
    "assetSpec",
    "compatibility",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^skin-[0-9]{2}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "cluster": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "material",
        "lighting",
        "mood"
      ],
      "properties": {
        "material": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "mood": {
          "type": "string"
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "canvas",
        "surfaces",
        "borders",
        "typography",
        "rotary",
        "sliders",
        "buttons",
        "tabs",
        "comboBoxes",
        "keyboard",
        "meters",
        "icons",
        "windowChrome",
        "hero",
        "accents",
        "texture",
        "lighting"
      ]
    },
    "assets": {
      "type": "object",
      "required": [
        "preview",
        "hero"
      ]
    },
    "assetSpec": {
      "type": "object"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "minimumPluginVersion",
        "apvtsChanges",
        "layoutChanges",
        "audioChanges"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "json",
        "assets",
        "runtime",
        "flStudio20"
      ]
    }
  }
}
