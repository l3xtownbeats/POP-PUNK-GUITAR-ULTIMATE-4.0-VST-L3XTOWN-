        "neon_basement",
        "chrome_parade",
        "wood_summer",
        "vintage_tape",
        "sunset_suburb",
        "special"
      ]
    },
    "layout": {
      "enum": [
        "STUDIO_CONSOLE",
        "WORKSTATION_TOPBAR",
        "RACK_SIDE",
        "COMPACT_MINI"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
