{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PPGU Theme Pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "colors",
    "metrics",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "colors": {
      "type": "object",
      "required": [
        "background",
        "surface",
        "accent",
        "text",
        "muted"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cornerRadius": {
          "type": "number"
        },
        "controlHeight": {
          "type": "number"
        },
        "spacing": {
          "type": "number"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
